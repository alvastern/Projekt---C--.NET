@page
@model IndexModel
@{
    ViewData["Title"] = "Renoveringskalkylator";
}

<header>
    <h1>Renoveringskalkylator</h1>
</header>

<p>Osäker på hur mycket material som går åt till din renovering? I denna renoveringskalkylator kan 
    du räkna ut hur mycket färg, golv och takpanel som går åt till en specifik yta i ditt hem. Ange 
    information om hur stor yta du vill täcka, samt hur många m² som varje paket/burk kommer att 
    täcka, så kommer denna kalkylator räkna ut hur mycket material du behöver köpa!</p>

<section>
    <h2>Hur mycket färg går åt?</h2>

    <form method="post">
        <div>
            <label for="colorArea" class="visually-hidden">Yta som ska täckas (m²)</label>
            <input type="number" id="colorArea" name="colorArea" placeholder="Yta som ska målas i m²" min="0.01" step="any" required/>

            <label for="strokeNumber" class="visually-hidden">Antal strykningar</label>
            <input type="number" id="strokeNumber" name="strokeNumber" placeholder="Antal strykningar" min="1" step="1" required/>

            <label for="litersMeters" class="visually-hidden">Liter som går åt per m²</label>
            <input type="number" id="litersMeters" name="litersMeters" placeholder="Liter som går åt per m²" min="0.01" step="any" required/>

            <label for="litersCan" class="visually-hidden">Liter per burk</label>
            <input type="number" id="litersCan" name="litersCan" placeholder="Liter per burk" min="0.01" step="any" required/>
        </div>

        <button type="submit">Beräkna</button>
    </form>

    <article>
        <h3>Antal liter</h3>
        <p></p>

        <h3>Antal burkar</h3>
        <p></p>
    </article>

    <!--Här ska det komma en reverseikon-->
</section>

<section>
    <h2>Hur mycket golv går åt?</h2>

    <form method="post" asp-page-handler="Floor">
        <div>
            <label for="floorArea" class="visually-hidden">Yta som ska täckas</label>
            <input type="number" id="floorArea" name="floorArea" placeholder="Yta som ska täckas" min="0.01" step="any" required/>

            <label for="floorWaste" class="visually-hidden">Spill i %</label>
            <input type="number" id="floorWaste" name="floorWaste" placeholder="Spill i %" min="0" step="any" required/>

            <label for="floorPackageCoverage" class="visually-hidden">M² per paket</label>
            <input type="number" id="floorPackageCoverage" name="floorPackageCoverage" placeholder="M² per paket" min="0.01" step="any" required/>
        </div>

        <button type="submit">Beräkna</button>
    </form>

    <!--Här visas felmeddelanden om inmatningen är ogiltig-->
    <div asp-validation-summary="All"></div>

    @if (Model.FloorMaterialArea.HasValue)
{
    <article>
        <h3>Materialbehov inklusive spill</h3>

        <!--Skriver ut materialbehovet från klassen PackageCalculator-->
        <p>@Model.FloorMaterialArea.Value.ToString("0.##") m²</p>

        <h3>Antal paket</h3>
        <!--Skriver ut antal paket från klassen PackageCalculator-->
        <p>@Model.FloorPackageCount paket</p>
    </article>
}

    <!--Här ska det komma en reverseikon-->
</section>

<section>
    <h2>Hur mycket takpanel går åt?</h2>

    <form method="post" asp-page-handler="Ceiling">
        <div>
            <label for="ceilingArea" class="visually-hidden">Yta som ska täckas</label>
            <input type="number" id="ceilingArea" name="ceilingArea" placeholder="Yta som ska täckas" min="0.01" step="any" required/>

            <label for="ceilingWaste" class="visually-hidden">Spill i %</label>
            <input type="number" id="ceilingWaste" name="ceilingWaste" placeholder="Spill i %" min="0" step="any" required/>

            <label for="ceilingPackageCoverage" class="visually-hidden">M² per paket</label>
            <input type="number" id="ceilingPackageCoverage" name="ceilingPackageCoverage" placeholder="M² per paket" min="0.01" step="any" required/>
        </div>

        <button type="submit">Beräkna</button>
    </form>

    @if (Model.CeilingMaterialArea.HasValue)
    {
        <article>
            <h3>Materialbehov inklusive spill</h3>

            <!--Skriver ut materialbehovet från klassen PackageCalculator-->
            <p>@Model.CeilingMaterialArea.Value.ToString("0.##") m²</p>

            <h3>Antal paket</h3>

            <!--Skriver ut antal paket från klassen PackageCalculator-->
            <p>@Model.CeilingPackageCount paket</p>
        </article>
    }

    <!--Här ska det komma en reverseikon-->
</section>